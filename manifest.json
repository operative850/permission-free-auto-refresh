{
  "manifest_version": 3,
  "name": "Permission-free Auto Refresh",
  "short_name": "PF Auto Refresh",
  "version": "2.0",
  "description": "Auto refresh any tab on a timer. Zero permissions. Open source.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Permission-free Auto Refresh",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
